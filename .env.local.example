# Nova AI — environment variables template
# Copy to .env.local and fill in your own values.

# JWT secret for auth (use `openssl rand -base64 48` in prod)
JWT_SECRET=please-change-this-to-a-super-secret-random-string-min-32-chars

# Blackbox AI
BLACKBOX_API_KEY=sk-your-blackbox-api-key
BLACKBOX_API_URL=https://api.blackbox.ai

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limit
RATE_LIMIT_PER_MINUTE=30

# Supabase (required for real DB; otherwise app falls back to local file store)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# Optional — client-side (not required for this app)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt
