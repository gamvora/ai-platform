# Nova AI — environment variables template
# Copy to .env.local and fill in your own values.

# JWT secret for auth (use `openssl rand -base64 48` in prod)
JWT_SECRET=please-change-this-to-a-super-secret-random-string-min-32-chars

# ── Bynara AI (chat, vision) ────────────────────────────────────────────────
# Get your key at https://router.bynara.id
BYNARA_API_KEY=sk-your-byNara-api-key
BYNARA_BASE_URL=https://router.bynara.id
# Optional: override default chat model (default: agnes-3-flash)
# BYNARA_DEFAULT_MODEL=agnes-3-flash

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limit
RATE_LIMIT_PER_MINUTE=30

# Supabase (optional — app falls back to local file store if not set)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
SUPABASE_STORAGE_BUCKET=uploads

# Optional HuggingFace T2I fallback (uncomment to enable)
# HF_API_KEY=hf_your_key_here
